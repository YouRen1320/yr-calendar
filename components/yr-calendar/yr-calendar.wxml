<view class="yr-calendar">
    <!-- 日历头部 -->
    <view class="calendar-header">
        <view class="header-left">
            <text class="header-date">{{year}}.{{month}}</text>
            <image src="/assets/image/DropDownArrow.png" class="dropdown-arrow" />
        </view>
        <view class="header-right">
            <image src="/assets/image/TheCalendar.png" class="calendar-icon" />
            <text class="today-text">回到今天</text>
        </view>
    </view>
    <!-- 日期部分 -->
    <!-- 周视图 -->
    <view wx:if="{{!isMonthView}}" class="dates-container">
        <view class="date-item {{item.isSelected ? 'selected' : ''}}" wx:for="{{nowWeekDays}}" wx:key="index" data-date="{{item.date}}" bind:tap="onWeekDateTap">
            <text class="day-label {{item.isSelected ? 'selected' : ''}}">{{item.weekLabel}}</text>
            <text class="day-number {{item.isSelected ? 'selected' : ''}}">{{item.date}}</text>
            <image src="{{item.isToday ? '/assets/image/sureDot.png' : '/assets/image/Dot.png'}}" class="day-dot" />
        </view>
    </view>
    <!-- 月视图 -->
    <view wx:if="{{isMonthView}}" class="month-container">
        <view class="week-row" wx:for="{{monthWeeks}}" wx:key="weekIndex" wx:for-index="weekIndex">
            <view class="date-item {{dateItem.isCurrentMonth ? '' : 'other-month'}} {{dateItem.isSelected ? 'selected' : ''}}" wx:for="{{item}}" wx:key="index" wx:for-item="dateItem" wx:for-index="dayIndex" data-week-index="{{weekIndex}}" data-day-index="{{dayIndex}}" data-date="{{dateItem.date}}" bind:tap="onMonthDateTap">
                <text class="day-label {{dateItem.isSelected ? 'selected' : ''}}">{{dateItem.weekLabel}}</text>
                <text class="day-number {{dateItem.isSelected ? 'selected' : ''}}">{{dateItem.date}}</text>
                <image src="{{dateItem.isToday ? '/assets/image/sureDot.png' : '/assets/image/Dot.png'}}" class="day-dot" />
            </view>
        </view>
    </view>
    <!-- 展开全部按钮——日历默认只显示一周，点击该按钮以后显示全部本月 -->
    <view class="expand-button" bind:tap="showMonth">
        <image src="/assets/image/{{isMonthView?'pullUp.png':'unfolding.png'}}" class="expand-icon" />
    </view>
</view>
