<view class="yr-calendar">
    <!-- 日历头部 -->
    <view class="calendar-header">
        <view class="header-left">
            <text class="header-date">2025.08</text>
            <image src="/assets/image/DropDownArrow.png" class="dropdown-arrow" />
        </view>
        <view class="header-right">
            <image src="/assets/image/TheCalendar.png" class="calendar-icon" />
            <text class="today-text">回到今天</text>
        </view>
    </view>

    <!-- 日期部分 -->
    <!-- 周视图 -->
    <view wx:if="{{!isMonthView}}" class="dates-container">
        <view class="date-item">
            <text class="day-label">日</text>
            <text class="day-number">17</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
        <view class="date-item selected">
            <text class="day-label selected">一</text>
            <text class="day-number selected">18</text>
            <image src="/assets/image/sureDot.png" class="day-dot" />
        </view>
        <view class="date-item">
            <text class="day-label">二</text>
            <text class="day-number">19</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
        <view class="date-item">
            <text class="day-label">三</text>
            <text class="day-number">20</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
        <view class="date-item">
            <text class="day-label">四</text>
            <text class="day-number">21</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
        <view class="date-item">
            <text class="day-label">五</text>
            <text class="day-number">22</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
        <view class="date-item">
            <text class="day-label">六</text>
            <text class="day-number">23</text>
            <image src="/assets/image/Dot.png" class="day-dot" />
        </view>
    </view>

    <!-- 月视图 -->
    <view wx:if="{{isMonthView}}" class="month-container">
        <!-- 星期标题行 -->
        <view class="month-week-header">
            <text class="week-header-item">日</text>
            <text class="week-header-item">一</text>
            <text class="week-header-item">二</text>
            <text class="week-header-item">三</text>
            <text class="week-header-item">四</text>
            <text class="week-header-item">五</text>
            <text class="week-header-item">六</text>
        </view>

        <!-- 第一周 -->
        <view class="week-row">
            <view class="date-cell other-month">
                <text class="cell-day">28</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">29</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">30</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">31</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">1</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">2</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell"><text class="cell-day">3</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>

        <!-- 第二周 -->
        <view class="week-row">
            <view class="date-cell">
                <text class="cell-day">4</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">5</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell"><text class="cell-day">6</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">7</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">8</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">9</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">10</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>

        <!-- 第三周 -->
        <view class="week-row">
            <view class="date-cell">
                <text class="cell-day">11</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">12</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">13</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">14</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">15</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">16</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell"><text class="cell-day">17</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>

        <!-- 第四周 -->
        <view class="week-row">
            <view class="date-cell" style=" background: rgba(65, 134, 253, 1);border-radius: 2px;">
                <text class="cell-day" style="color: white;">18</text>
                <image src="/assets/image/sureDot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">19</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">20</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">21</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">22</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">23</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">24</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>

        <!-- 第五周 -->
        <view class="week-row">
            <view class="date-cell">
                <text class="cell-day">25</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">26</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">27</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">28</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">29</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">30</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell">
                <text class="cell-day">31</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>

        <!-- 第六周 -->
        <view class="week-row">
            <view class="date-cell other-month">
                <text class="cell-day">1</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">2</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">3</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">4</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">5</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">6</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
            <view class="date-cell other-month">
                <text class="cell-day">7</text>
                <image src="/assets/image/Dot.png" class="day-dot" />
            </view>
        </view>
    </view>

    <!-- 展开全部按钮——日历默认只显示一周，点击该按钮以后显示全部本月 -->
    <view class="expand-button" bind:tap="showMonth">
        <image src="/assets/image/unfolding.png" class="expand-icon" />
    </view>

    <!-- 班次和设置按钮 -->
    <view class="bottom-actions">
        <view class="action-button">
            <image src="/assets/image/settings.png" class="action-icon" />
            <text class="action-text">考勤班次</text>
        </view>
        <view class="action-button">
            <image src="/assets/image/settings.png" class="action-icon" />
            <text class="action-text">打卡位置</text>
        </view>
    </view>

</view>